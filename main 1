import logging
from telegram import (
    Update,
    ReplyKeyboardMarkup,
    ReplyKeyboardRemove,
    InlineKeyboardButton,
    InlineKeyboardMarkup
)
from telegram.ext import (
    Updater,
    CommandHandler,
    MessageHandler,
    Filters,
    ConversationHandler,
    CallbackQueryHandler,
    CallbackContext
)

# Настройка логов
logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s', 
    level=logging.INFO
)
logger = logging.getLogger(__name__)

# Стадии разговора
RISK_TEST, ASSET_SELECTION, CURRENCY_SELECT, ASSET_VALUE, MORE_ASSETS, RECOMMENDATIONS = range(6)

# Данные для теста
risk_questions = [
    "1. Какова ваша цель инвестирования?\n"
    "а) Сохранение капитала\n"
    "б) Стабильный рост с умеренным риском\n"
    "в) Максимальная прибыль независимо от риска",
    
    "2. На какой срок вы инвестируете?\n"
    "а) Менее 1 года\n"
    "б) 1-3 года\n"
    "в) Более 5 лет",
    
    "3. Ваша реакция при падении портфеля на 20%:\n"
    "а) Продам все активы\n"
    "б) Оставлю как есть\n"
    "в) Куплю больше активов"
]

risk_answers = {"а": 1, "б": 2, "в": 3}
risk_thresholds = {5: "Консервативный", 7: "Умеренный", 9: "Рискованный"}

# Идеальное распределение активов по профилям
ideal_allocation = {
    "Консервативный": {
        "Недвижимость": 35,
        "Акции": 15,
        "Облигации": 40,
        "Криптовалюта": 0,
        "Бизнес/Компания": 10
    },
    "Умеренный": {
        "Недвижимость": 25,
        "Акции": 25,
        "Облигации": 30,
        "Криптовалюта": 10,
        "Бизнес/Компания": 10
    },
    "Рискованный": {
        "Недвижимость": 10,
        "Акции": 30,
        "Облигации": 10,
        "Криптовалюта": 40,
        "Бизнес/Компания": 10
    }
}

# Начало работы с ботом
def start(update: Update, context: CallbackContext) -> int:
    user = update.message.from_user
    update.message.reply_text(
        f"Привет, {user.first_name}! Я помогу проанализировать твой инвестиционный портфель.\n"
        "Сначала определим твой риск-профиль. Ответь на 3 вопроса:\n\n"
        f"{risk_questions[0]}",
        reply_markup=ReplyKeyboardMarkup(
            [['а', 'б', 'в']], 
            one_time_keyboard=True,
            resize_keyboard=True
        )
    )
    context.user_data['risk_score'] = 0
    context.user_data['question_index'] = 0
    return RISK_TEST

# Обработка ответов на вопросы о риске
def risk_test(update: Update, context: CallbackContext) -> int:
    answer = update.message.text.lower()
    if answer not in ['а', 'б', 'в']:
        update.message.reply_text("Пожалуйста, выбери а, б или в")
        return RISK_TEST
    
    score = risk_answers[answer]
    context.user_data['risk_score'] += score
    context.user_data['question_index'] += 1
    
    if context.user_data['question_index'] < len(risk_questions):
        update.message.reply_text(
            risk_questions[context.user_data['question_index']],
            reply_markup=ReplyKeyboardMarkup(
                [['а', 'б', 'в']], 
                one_time_keyboard=True,
                resize_keyboard=True
            )
        )
        return RISK_TEST
    else:
        return determine_risk_profile(update, context)

# Определение риск-профиля
def determine_risk_profile(update: Update, context: CallbackContext) -> int:
    score = context.user_data['risk_score']
    if score <= 5:
        profile = "Консервативный"
    elif score <= 7:
        profile = "Умеренный"
    else:
        profile = "Рискованный"
    
    context.user_data['risk_profile'] = profile
    update.message.reply_text(
        f"✅ Твой риск-профиль: <b>{profile}</b>\n"
        "Теперь добавь активы из своего портфеля:",
        parse_mode='HTML',
        reply_markup=ReplyKeyboardMarkup(
            [['Недвижимость', 'Акции'], ['Облигации', 'Криптовалюта'], ['Бизнес/Компания', 'Готово']],
            resize_keyboard=True,
            one_time_keyboard=True
        )
    )
    context.user_data['assets'] = {}
    return ASSET_SELECTION

# Выбор актива
def asset_selection(update: Update, context: CallbackContext) -> int:
    asset = update.message.text
    if asset == 'Готово':
        if not context.user_data['assets']:
            update.message.reply_text("Добавь хотя бы один актив!")
            return ASSET_SELECTION
        return show_recommendations(update, context)
    
    context.user_data['current_asset'] = asset
    update.message.reply_text(
        f"Выбери валюту для {asset}:",
        reply_markup=ReplyKeyboardMarkup(
            [['RUB', 'USD']], 
            resize_keyboard=True,
            one_time_keyboard=True
        )
    )
    return CURRENCY_SELECT

# Выбор валюты
def currency_select(update: Update, context: CallbackContext) -> int:
    currency = update.message.text
    context.user_data['current_currency'] = currency
    update.message.reply_text(
        f"Введи стоимость {context.user_data['current_asset']} в {currency}:",
        reply_markup=ReplyKeyboardRemove()
    )
    return ASSET_VALUE

# Ввод суммы актива
def asset_value(update: Update, context: CallbackContext) -> int:
    try:
        value = float(update.message.text.replace(',', '.'))
        asset = context.user_data['current_asset']
        currency = context.user_data['current_currency']
        
        # Сохраняем с конвертацией в USD (курс условный)
        if currency == 'RUB':
            value = value / 75.0
        
        context.user_data['assets'][asset] = context.user_data['assets'].get(asset, 0) + value
        
        update.message.reply_text(
            f"✅ {asset} добавлен!\nДобавить еще актив?",
            reply_markup=ReplyKeyboardMarkup(
                [['Да', 'Нет']], 
                resize_keyboard=True,
                one_time_keyboard=True
            )
        )
        return MORE_ASSETS
    except ValueError:
        update.message.reply_text("Пожалуйста, введи число")
        return ASSET_VALUE

# Обработка добавления активов
def more_assets(update: Update, context: CallbackContext) -> int:
    if update.message.text.lower() == 'да':
        update.message.reply_text(
            "Выбери тип актива:",
            reply_markup=ReplyKeyboardMarkup(
                [['Недвижимость', 'Акции'], ['Облигации', 'Криптовалюта'], ['Бизнес/Компания', 'Готово']],
                resize_keyboard=True,
                one_time_keyboard=True
            )
        )
        return ASSET_SELECTION
    else:
        return show_recommendations(update, context)

# Формирование рекомендаций
def show_recommendations(update: Update, context: CallbackContext) -> int:
    profile = context.user_data['risk_profile']
    assets = context.user_data['assets']
    
    # Расчет текущего распределения
    total = sum(assets.values())
    current_percent = {asset: (value / total) * 100 for asset, value in assets.items()}
    
    # Идеальное распределение
    ideal = ideal_allocation[profile]
    
    # Анализ отклонений
    recommendations = []
    for asset, current_pct in current_percent.items():
        ideal_pct = ideal.get(asset, 0)
        
        if current_pct > ideal_pct + 10:  # Превышение более чем на 10%
            recommendations.append(
                f"⚠️ Слишком много в {asset} ({current_pct:.1f}% vs идеал {ideal_pct}%). "
                f"Рекомендую уменьшить до {ideal_pct}%"
            )
    
    # Специальные проверки
    if profile == "Консервативный" and "Криптовалюта" in assets:
        recommendations.append(
            "🔻 Консервативному профилю не рекомендуется криптовалюта. "
            "Перемести средства в облигации или недвижимость"
        )
    
    if profile == "Рискованный" and assets.get("Облигации", 0) > 0.2 * total:
        recommendations.append(
            "🔻 Для рискованного профиля слишком много облигаций. "
            "Рассмотри акции роста или криптовалюту"
        )
    
    # Формирование отчета
    report = f"📊 <b>Анализ портфеля ({profile} профиль)</b>\n\n"
    report += "🏠 <u>Текущее распределение:</u>\n"
    for asset, pct in current_percent.items():
        report += f"• {asset}: {pct:.1f}%\n"
    
    report += "\n⭐ <u>Идеальное распределение:</u>\n"
    for asset, pct in ideal.items():
        report += f"• {asset}: {pct}%\n"
    
    if recommendations:
        report += "\n📌 <b>Рекомендации:</b>\n" + "\n".join(recommendations)
    else:
        report += "\n✅ Ваш портфель оптимально сбалансирован для вашего риск-профиля!"
    
    update.message.reply_text(report, parse_mode='HTML')
    return ConversationHandler.END

# Отмена диалога
def cancel(update: Update, context: CallbackContext) -> int:
    update.message.reply_text('Диалог прерван', reply_markup=ReplyKeyboardRemove())
    return ConversationHandler.END

# Основная функция
def main() -> None:
    updater =Updater("8212292281:AAF9sMOV2hSC5qAjO9xqpct8eeN-pY4hQLU")
    dispatcher = updater.dispatcher

    conv_handler = ConversationHandler(
        entry_points=[CommandHandler('start', start)],
        states={
            RISK_TEST: [MessageHandler(Filters.text & ~Filters.command, risk_test)],
            ASSET_SELECTION: [MessageHandler(Filters.text & ~Filters.command, asset_selection)],
            CURRENCY_SELECT: [MessageHandler(Filters.text & ~Filters.command, currency_select)],
            ASSET_VALUE: [MessageHandler(Filters.text & ~Filters.command, asset_value)],
            MORE_ASSETS: [MessageHandler(Filters.text & ~Filters.command, more_assets)],
            RECOMMENDATIONS: [MessageHandler(Filters.text & ~Filters.command, show_recommendations)]
        },
        fallbacks=[CommandHandler('cancel', cancel)],
    )

    dispatcher.add_handler(conv_handler)
    updater.start_polling()
    updater.idle()

if __name__ == '__main__':
    main()
